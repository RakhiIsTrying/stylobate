# .env.example
# Copy to .env.local (frontend) and backend/.env, then fill in.

# --- Supabase (shared) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=ey...                   # public, safe to expose to browser
SUPABASE_SERVICE_ROLE_KEY=                # optional in Phase 0 (writes go through user JWT + RLS)
SUPABASE_JWT_SECRET=                      # optional in Phase 0 (verification uses JWKS from SUPABASE_URL)

# --- Backend ---
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Anthropic (Phase 1+; harmless to leave empty in Phase 0) ---
ANTHROPIC_API_KEY=sk-ant-...
